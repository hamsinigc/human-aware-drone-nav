          <waypoint><time>0.0</time><pose>0.41 -1.92 1.0 0 0 3.35</pose></waypoint>
          <waypoint><time>3.8</time><pose>-1.45 -1.32 1.0 0 0 2.31</pose></waypoint>
          <waypoint><time>7.6</time><pose>-1.87 0.60 1.0 0 0 1.26</pose></waypoint>
          <waypoint><time>11.4</time><pose>-0.41 1.92 1.0 0 0 0.21</pose></waypoint>
          <waypoint><time>15.2</time><pose>1.45 1.32 1.0 0 0 -0.83</pose></waypoint>
          <waypoint><time>19.0</time><pose>1.87 -0.60 1.0 0 0 -1.88</pose></waypoint>
          <waypoint><time>22.9</time><pose>0.41 -1.92 1.0 0 0 -2.93</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="pedestrian_4">
      <pose>-1.52 1.88 1.0 0 0 0</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking"><filename>walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script><loop>true</loop><auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>-1.52 1.88 1.0 0 0 3.82</pose></waypoint>
          <waypoint><time>4.9</time><pose>-2.39 -0.37 1.0 0 0 4.87</pose></waypoint>
          <waypoint><time>9.9</time><pose>-0.87 -2.25 1.0 0 0 5.91</pose></waypoint>
          <waypoint><time>14.8</time><pose>1.52 -1.88 1.0 0 0 6.96</pose></waypoint>
          <waypoint><time>19.7</time><pose>2.39 0.37 1.0 0 0 8.01</pose></waypoint>
          <waypoint><time>24.7</time><pose>0.87 2.25 1.0 0 0 9.06</pose></waypoint>
          <waypoint><time>29.6</time><pose>-1.52 1.88 1.0 0 0 10.10</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="pedestrian_5">
      <pose>-0.57 2.81 1.0 0 0 0</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking"><filename>walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script><loop>true</loop><auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>-0.57 2.81 1.0 0 0 3.34</pose></waypoint>
          <waypoint><time>4.0</time><pose>-2.72 0.91 1.0 0 0 4.39</pose></waypoint>
          <waypoint><time>8.0</time><pose>-2.15 -1.90 1.0 0 0 5.44</pose></waypoint>
          <waypoint><time>12.0</time><pose>0.57 -2.81 1.0 0 0 6.48</pose></waypoint>
          <waypoint><time>16.0</time><pose>2.72 -0.91 1.0 0 0 7.53</pose></waypoint>
          <waypoint><time>20.0</time><pose>2.15 1.90 1.0 0 0 8.58</pose></waypoint>
          <waypoint><time>24.1</time><pose>-0.57 2.81 1.0 0 0 9.62</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="pedestrian_6">
      <pose>-0.01 3.32 1.0 0 0 0</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking"><filename>walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script><loop>true</loop><auto_start>true</auto_start>
